{
  "name": "blog",
  "version": "0.1.0",
  "private": true,
  "description": "Static Markdown blog for blog.doxiebytes.com",
  "type": "module",
  "scripts": {
    "build": "tsx src/build/index.ts",
    "dev": "tsx src/build/dev.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.site.json --noEmit",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "chokidar": "^4.0.3",
    "gray-matter": "^4.0.3",
    "marked": "^18.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
